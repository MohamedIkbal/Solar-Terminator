    {
        "id": "exec_detections",
        "type": "exec",
        "z": "flow1",
        "command": "bash -c \"source /opt/ros/lyrical/setup.bash && source /home/ikbal/ros2_ws/install/setup.bash && until ros2 topic echo /object_detection/detections --field id vision_msgs/msg/Detection2D; do sleep 2; done\"",
        "addpay": false,
        "append": "",
        "useSpawn": "true",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "stream /object_detection/detections",
        "x": 480,
        "y": 340,
        "wires": [
            [
                "fn_count"
            ],
            [],
            []
        ]
    },
    {
        "id": "fn_count",
        "type": "function",
        "z": "flow1",
        "name": "count match for selected class",
        "func": "const text = (msg.payload || \"\").toString();\nconst target = flow.get(\"target_class\") || \"\";\nif (!target) { return null; }\n// stdout from the exec node is NOT guaranteed to arrive one-line-per-chunk;\n// split defensively and count every matching line in the chunk, so a bundled\n// chunk (e.g. \"solar_sail\\n---\") never silently loses a match.\nlet count = flow.get(\"detection_count\") || 0;\nlet matched = false;\nconst lines = text.split(/\\r?\\n/);\nfor (const raw of lines) {\n    const line = raw.trim();\n    if (!line || line === \"---\") { continue; }\n    if (line === target) {\n        count += 1;\n        matched = true;\n    }\n}\nif (!matched) { return null; }\nflow.set(\"detection_count\", count);\nreturn {payload: count};\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 320,
        "wires": [
            [
                "txt_count"
            ]
        ]
    },
