    {
        "id": "route1",
        "type": "function",
        "z": "flow1",
        "name": "build ros2 pub command",
        "func": "const cls = msg.payload;\n// Remember the selected class and reset the running count so the\n// dashboard counter tracks ONLY the currently selected object.\nflow.set('target_class', cls);\nflow.set('detection_count', 0);\nconst cmd = \"bash -c \\\"source /opt/ros/lyrical/setup.bash && source /home/ikbal/ros2_ws/install/setup.bash && ros2 topic pub --once /object_detection/target_class std_msgs/msg/String '{data: \" + cls + \"}'\\\"\";\nreturn [ {payload: cmd}, {payload: 'Tracking: ' + cls}, {payload: 0} ];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 180,
        "wires": [
            [
                "exec1"
            ],
            [
                "txt1"
            ],
            [
                "txt_count"
            ]
        ]
    },
    {
        "id": "exec1",
        "type": "exec",
        "z": "flow1",
        "command": "",
        "addpay": "payload",
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "publish target_class",
        "x": 680,
        "y": 160,
        "wires": [
