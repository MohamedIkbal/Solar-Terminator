        gripper_support:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        tool:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        world:
          Alpha: 1
          Show Axes: false
          Show Trail: false
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        arm_0:
          Value: true
        arm_0_support:
          Value: true
        arm_1_support_0:
          Value: true
        arm_1_support_1a:
          Value: true
        arm_1_support_1b:
          Value: true
        arm_1a:
          Value: true
        arm_1b:
