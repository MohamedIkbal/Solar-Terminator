<?xml version="1.0"?>
<sdf version="1.8">
  <world name="moon_world">
    <!-- The MeArm's parallel four-bar linkage is held together by URDF
         <mimic> joints. Per Gazebo's own release notes, mimic constraints
         are only implemented by the Bullet-Featherstone physics engine
         plugin (DART and ODE do not support them) -- so the Physics system
         plugin below explicitly loads gz-physics-bullet-featherstone-plugin.
         Without this, mimic'd links are fully unconstrained and the
         linkage falls apart under gravity. -->
    <physics name="default_physics" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <!-- Moon surface gravity: 1.62 m/s^2 (vs Earth's 9.81 m/s^2) -->
    <gravity>0 0 -1.62</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- No atmosphere on the Moon: near-black sky, low ambient fill, harsh shadows -->
    <scene>
      <ambient>0.12 0.12 0.13 1</ambient>
      <background>0.01 0.01 0.03 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.85</direction>
    </light>

    <!-- Lunar regolith ground plane: ashen grey, no vegetation/water -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.45 0.44 0.43 1</ambient>
            <diffuse>0.5 0.49 0.47 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lander_pad">
      <static>true</static>
      <pose>0 0 0.14 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.4 0.28</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.4 0.28</size></box></geometry>
          <material>
            <ambient>0.35 0.36 0.38 1</ambient>
            <diffuse>0.4 0.41 0.43 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crater_1">
      <static>true</static>
      <pose>1.2 0.8 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.38 0.37 0.36 1</ambient>
            <diffuse>0.42 0.41 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crater_2">
      <static>true</static>
      <pose>-1.0 1.3 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.025</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.38 0.37 0.36 1</ambient>
            <diffuse>0.42 0.41 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crater_3">
      <static>true</static>
      <pose>0.9 -1.1 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>0.03</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>0.03</length></cylinder></geometry>
          <material>
            <ambient>0.38 0.37 0.36 1</ambient>
            <diffuse>0.42 0.41 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_1">
      <static>true</static>
      <pose>0.6 0.3 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <material>
            <ambient>0.25 0.24 0.23 1</ambient>
            <diffuse>0.28 0.27 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>-0.5 -0.6 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <material>
            <ambient>0.25 0.24 0.23 1</ambient>
            <diffuse>0.28 0.27 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_3">
      <static>true</static>
      <pose>0.3 -0.8 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material>
            <ambient>0.25 0.24 0.23 1</ambient>
            <diffuse>0.28 0.27 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  
    <!-- Drift render-confirm: the Sensors system renders camera sensors (ogre2,
         headless-capable) so the observer can read a frame. Added independently of
         the other system plugins — a world often has SceneBroadcaster (pose) but no
         Sensors (no camera), and the injected render-confirm camera needs it. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Added by Drift: a fixed camera looking at the origin, so the scene can be
         checked visually after it launches. Inert — static, no collisions, no
         dynamics; it does not affect the simulation. Safe to delete if you do not
         want it, though Drift will not be able to show you the running scene. -->
    <model name="drift_scene_view">
      <static>true</static>
      <pose>3 0 2 0 0.34 3.14159</pose>
      <link name="link">
        <sensor type="camera" name="drift_scene_view_camera">
          <topic>/drift/scene_view</topic>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
</world>
</sdf>
