<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mearm">
  <!-- Brushed aluminum finish: the MeArm chassis/links are machined aluminum -->
  <material name="white">
    <color rgba="0.55 0.56 0.58 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.95 0.45 0.05 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- Machined aluminum construction (density ~2700 kg/m^3). Every link below
       carries an explicit <inertial> sized from its approximate bounding box
       at that density, with a 1e-5 kg*m^2 floor on each axis for solver
       stability (thin brackets/fingers would otherwise compute inertia far
       below what the physics engine can integrate reliably). -->

  <link name="world"/>

  <joint name="world_robot_joint" type="fixed">
    <axis xyz="0 0 1" />
    <origin xyz="0 0 0.28"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- controllable joints -->
  <!-- joint_0 - base servo -->
  <!-- joint_1 - right servo  -->
  <!-- joint_2 - left servo -->
  <!-- joint_3 - gripper servo -->

  <joint name="joint_0" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-1.2" upper="1.2" effort="0.5" velocity="0.5"/>
    <dynamics damping="0.2" friction="0.05"/>
    <origin xyz="0 0 0.024"/>
    <parent link="base_link"/>
    <child link="column"/>
  </joint>

  <joint name="joint_1" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.0" effort="0.5" velocity="0.5"/>
    <dynamics damping="0.2" friction="0.05"/>
    <origin rpy="1.5707 -1.5707 0" xyz="0.014 0 0.029"/>
    <parent link="column"/>
    <child link="arm_0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <axis xyz="0 0 1" />
    <!-- Effort raised from the copy-pasted 0.5 N*m placeholder: joint_2 carries
         three downstream support/mimic links (arm_1_support_0/1a/1b), more
         gravity load than joint_0 (vertical-axis, no gravity torque) or
         joint_1 (lighter chain) — 0.5 N*m was saturating the position
         controller and stalling the joint at its lower limit. -->
    <limit lower="0.0" upper="1.57" effort="3.0" velocity="0.5"/>
    <dynamics damping="0.2" friction="0.05"/>
    <origin rpy="1.57 0 3.14" xyz="0.015 0.01 0.03"/>
    <parent link="column"/>
    <child link="arm_1_support_0"/>
  </joint> 

  <!-- base column -->

  <link name="base_link">
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="8.2e-5" ixy="0.0" ixz="0.0" iyy="8.2e-5" iyz="0.0" izz="1.62e-4"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin xyz="-0.963 -0.19 -0.002"/>  
    </visual>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/base_top.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0.7853" xyz="-0.632 -0.9 0.016"/>
    </visual>
    
    <visual>
      <geometry>
        <cylinder radius="0.002" length="0.02"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.022 0.022 0.008"/>
    </visual>

    <visual>
      <geometry>
        <cylinder radius="0.002" length="0.02"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.022 -0.022 0.008"/>
    </visual>

    <visual>
      <geometry>
        <cylinder radius="0.002" length="0.02"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="-0.022 0.022 0.008"/>
    </visual>

    <visual>
      <geometry>
        <cylinder radius="0.002" length="0.02"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="-0.022 -0.022 0.008"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="-0.963 -0.19 -0.002"/>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/base_top.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0.7853" xyz="-0.631 -0.9 0.016"/>
    </collision>
  </link>

  <link name="column">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="6.375e-5" ixy="0.0" ixz="0.0" iyy="6.375e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 -1.5707" xyz="-0.231 -0.05 -0.002"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 -1.5707" xyz="-0.231 -0.05 -0.002"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="1.5707 0 0" xyz="-0.8 0.022 -0.1655"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="-0.8 0.022 -0.1655"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="1.5707 0 3.1415" xyz="0.71 -0.022 -0.164"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5707 0 3.1415" xyz="0.71 -0.022 -0.164"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_board.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="1.5707 0 -1.5707" xyz="0.028 -0.16 -0.18"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_board.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5707 0 -1.5707" xyz="0.028 -0.16 -0.18"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_board.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="1.5707 0 -1.5707" xyz="-0.023 -0.16 -0.18"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_board.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5707 0 3.1415" xyz="0.71 -0.022 -0.164"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_connector.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="1.5707 0 0" xyz="-0.08 0.005 -0.19"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/column_connector.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="-0.08 0.005 -0.19"/>
    </collision>
  </link>

  <!-- arm 0 - controlled by right servo -->

  <link name="arm_0">
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.878e-5" iyz="0.0" izz="2.13e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_0_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="-1.5707 0 0" xyz="0.031 0 0.214"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_0_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="-1.5707 0 0" xyz="0.031 0 0.214"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_0_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="3.1415 0 0" xyz="0.0515 0.179 0.013"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_0_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="3.1415 0 0" xyz="0.0515 0.179 0.013"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_0_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="3.1415 0 0" xyz="0.0418 0.154 -0.007"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_0_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="3.1415 0 0" xyz="0.0418 0.154 -0.007"/>
    </collision>
  </link>

  <!-- arm_0 - link from column to connector -->

  <link name="arm_0_support">
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.181 -0.162 0.003"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.181 -0.162 0.003"/>
    </collision>
  </link>

  <joint name="arm_0_support_mimic" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="0.0" upper="2.57" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin rpy="1.57 0 0" xyz="-0.021 -0.019 0.045"/>
    <parent link="column"/>
    <mimic joint="joint_1" multiplier="1" offset="1.57" />
    <child link="arm_0_support"/>
  </joint> 

  <!-- connector -->

  <link name="connector">
    <inertial>
      <mass value="0.006"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_connector.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 -1.5707" xyz="-0.1935 0.45 0.013"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_connector.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 -1.5707" xyz="-0.1935 0.45 0.013"/>
    </collision>
  </link>

  <joint name="arm_0_connector_mimic" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-2.57" upper="0.0" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin xyz="0.08 0 0"/>
    <parent link="arm_0"/>
    <mimic joint="joint_1" multiplier="-1" offset="-1.57" />
    <child link="connector"/>
  </joint> 

  <!-- arm_1 - link from connector to gripper -->

  <joint name="joint_2_mimic_0a" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="0.0" upper="1.57" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin xyz="0.035 0 0"/>
    <mimic joint="joint_2" multiplier="-1" offset="1.57" />
    <parent link="arm_1_support_0"/>
    <child link="arm_1_support_1a"/>
  </joint>

  <joint name="joint_2_mimic_0b" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-1.0" upper="1.57" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin xyz="0 0 0"/>
    <mimic joint="joint_1" multiplier="-1" offset="0" />
    <parent link="arm_1_support_1a"/>
    <child link="arm_1_support_1b"/>
  </joint>

  <joint name="joint_2_mimic_1" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="-1.57" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin xyz="0.08 0 0"/>
    <mimic joint="joint_2" multiplier="-1" offset="-1.57" />
    <parent link="arm_0"/>
    <child link="arm_1a"/>
  </joint>

  <joint name="arm1_mimic_0" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-1.0" upper="1.57" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin xyz="0 0 0"/>
    <mimic joint="joint_1" multiplier="-1" offset="0" />
    <parent link="arm_1a"/>
    <child link="arm_1b"/>
  </joint>

  <link name="arm_1a">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
  </link>

  <link name="arm_1b">
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.878e-5" iyz="0.0" izz="2.13e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="-0.231 -0.177 -0.013"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="-0.231 -0.177 -0.013"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.182 -0.161 0.013"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.182 -0.161 0.013"/>
    </collision>
  </link>

  <!-- arm support -->

  <link name="arm_1_support_0">
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/servo_actuator.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 3.14" xyz="0.532 0.18 0.005"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/servo_actuator.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 3.14" xyz="0.532 0.18 0.005"/>
    </collision>
  </link>

  <link name="arm_1_support_1a">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
  </link>
  
  <link name="arm_1_support_1b">
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.18 -0.162 0.003"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.18 -0.162 0.003"/>
    </collision>
  </link>

  <!-- gripper support -->

  <joint name="gripper_support_mimic" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="-1.57" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin rpy="0 0 1.57" xyz="0.012 0.018 0.014"/>
    <mimic joint="joint_2" multiplier="-1" offset="-1.57" />
    <parent link="connector"/>
    <child link="gripper_support"/>
  </joint>

  <link name="gripper_support">
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.18 -0.162 0"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/arm_1_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 0 0" xyz="0.18 -0.162 0"/>
    </collision>
  </link>

  <!-- gripper -->

  <joint name="gripper_holder" type="revolute">
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="0.0" effort="0.3" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin rpy="0 0 1.57" xyz="0.081 0.001 0.0"/>
    <mimic joint="joint_2" multiplier="1" offset="-1.57" />
    <parent link="arm_1b"/>
    <child link="gripper"/>
  </joint>

  <link name="gripper">
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.933e-5" iyz="0.0" izz="2.267e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 1.57 1.57" xyz="0.18 -0.005 0.1538"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 1.57 1.57" xyz="0.18 -0.005 0.1538"/>
    </collision>

    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_support.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 3.14 3.92" xyz="-0.045 0.168 0.016"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_support.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
      <origin rpy="0 3.14 3.92" xyz="-0.045 0.168 0.016"/>
    </collision>

    <visual>
      <geometry>
        <box size="0.024 0.018 0.012" />
      </geometry> 
      <material name="blue"/>    
      <origin rpy="0 0 0" xyz="0.004 0.0035 0.002"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.024 0.018 0.012" />
      </geometry> 
      <material name="blue"/>    
      <origin rpy="0 0 0" xyz="0.004 0.0035 0.002"/>
    </collision>
  </link>

  <!-- left gripper -->

  <joint name="joint_3" type="revolute">
    <axis xyz="0 0 1" />
    <!-- Empirically verified free range: commanding past ~0.42 rad (even with
         ample effort/gain) drives into a hard mechanical stop in this gripper's
         mesh geometry, not an actuation shortfall. Capping upper to the real
         achievable limit avoids commanding the joint uselessly into its stop. -->
    <limit lower="0" upper="0.42" effort="3.0" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin rpy="-1.57 0 0" xyz="0.028 -0.003 -0.007"/>
    <parent link="gripper"/>
    <child link="gripper_left"/>
  </joint>

  <link name="gripper_left">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
      <origin rpy="0 3.14 3.14" xyz="-0.535 0.212 0.0"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
      <origin rpy="0 3.14 3.14" xyz="-0.535 0.212 0.0"/>
    </collision>
  </link>

  <!-- right gripper -->

  <joint name="joint_3_mimic" type="revolute">
    <axis xyz="0 0 1" />
    <!-- mirrors joint_3 (multiplier -1): limits must span the negated image of
         joint_3's corrected [0, 0.42] range, not the old unreachable 1.57 -->
    <limit lower="-0.42" upper="0" effort="3.0" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.02"/>
    <origin rpy="-1.57 0 0" xyz="0.028 -0.003 0.011"/>
    <mimic joint="joint_3" multiplier="-1" offset="0" />
    <parent link="gripper"/>
    <child link="gripper_right"/>
  </joint>

  <link name="gripper_right">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
      <origin rpy="0 3.14 -1.57" xyz="-0.185 -0.57 0.0"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://mearm_description/meshes/gripper_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
      <origin rpy="0 3.14 -1.57" xyz="-0.185 -0.57 0.0"/>
    </collision>
  </link>

  <!-- tool tf -->

  <joint name="tool_joint" type="fixed">
    <axis xyz="0 0 1" />
    <origin rpy="-1.57 0 0" xyz="0.043 -0.005 0.003"/>
    <parent link="gripper"/>
    <child link="tool"/>
  </joint>

  <link name="tool">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="1.0e-5"/>
    </inertial>
  </link>

  <!-- Gazebo-side material mirrors (Gazebo ignores plain URDF <material> colors
       unless restated here per link) -->
  <gazebo reference="base_link">
    <material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse><specular>0.3 0.3 0.3 1.0</specular></material>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="column">
    <material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.95 0.45 0.05 1.0</diffuse><specular>0.3 0.3 0.3 1.0</specular></material>
