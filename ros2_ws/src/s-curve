Option 2: STM32duino (Arduino core for STM32)

If you prefer the Arduino IDE / STM32duino core, the same smoothstep code above compiles unchanged. You can also use the standard Arduino Servo.h wrapper with your own timing:


#include <Servo.h>

Servo myServo;
float currentAngle = 90;
float targetAngle = 90;
unsigned long moveStart = 0;
unsigned long moveDuration = 1000;
bool moving = false;

float smootherstep(float t) {
  if (t <= 0) return 0;
  if (t >= 1) return 1;
  float t2 = t * t, t3 = t2 * t, t4 = t3 * t, t5 = t4 * t;
  return 6 * t5 - 15 * t4 + 10 * t3;
}

void moveTo(float angle, unsigned long ms) {
  currentAngle = myServo.read();
  targetAngle = angle;
  moveStart = millis();
  moveDuration = ms;
  moving = true;
}

void updateServo() {
  if (!moving) return;
  unsigned long elapsed = millis() - moveStart;
  if (elapsed >= moveDuration) {
    myServo.write(targetAngle);
    moving = false;
    return;
  }
  float t = (float)elapsed / (float)moveDuration;
  float pos = currentAngle + (targetAngle - currentAngle) * smootherstep(t);
  myServo.write(pos);
}

void setup() {
  myServo.attach(PA1); // STM32 pin
  myServo.write(90);
  moveTo(160, 1200);
}

void loop() {
  updateServo();
  if (!moving) {
    delay(800);
    moveTo(20, 1200);
    delay(800);
    moveTo(90, 1200);
  }
}
