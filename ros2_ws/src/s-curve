#define SERVO_CHANNEL        TIM_CHANNEL_1
#define SERVO_GPIO_PORT      GPIOA
#define SERVO_GPIO_PIN       GPIO_PIN_0

#define PWM_FREQ_HZ          50UL              /* 20 ms period */
#define TIMER_CLK_HZ         90000000UL        /* TIM2 is on APB1; x2 if prescaler>1 */
#define COUNTER_CLK_HZ       1000000UL         /* 1 MHz => 1 tick = 1 us */
#define PRESCALER_VAL        ((TIMER_CLK_HZ / COUNTER_CLK_HZ) - 1)   /* 89 */
#define PERIOD_VAL           (COUNTER_CLK_HZ / PWM_FREQ_HZ - 1)     /* 19999 for 20 ms */

#define SERVO_MIN_US         500UL   /* 0 degrees */
#define SERVO_MAX_US         2500UL  /* 180 degrees */

/* Private variables ---------------------------------------------------------*/
Servo_t my_servo;
TIM_HandleTypeDef htim2;

/* Function prototypes -------------------------------------------------------*/
static float smootherstep(float t);
static void servo_set_angle(Servo_t *s, float angle);
void servo_move_to(Servo_t *s, float target_angle, uint32_t duration_ms);
void servo_update(Servo_t *s);

/* USER CODE BEGIN PFP */

/* Smootherstep cubic S-curve: 6t^5 - 15t^4 + 10t^3 */
static float smootherstep(float t)
{
    if (t <= 0.0f) return 0.0f;
    if (t >= 1.0f) return 1.0f;

    float t2 = t * t;
    float t3 = t2 * t;
    float t4 = t3 * t;
    float t5 = t4 * t;

    return (6.0f * t5) - (15.0f * t4) + (10.0f * t3);
}

/* Convert degrees to PWM compare value (1 tick = 1 us) */
static void servo_set_angle(Servo_t *s, float angle)
{
    if (angle < 0.0f)  angle = 0.0f;
    if (angle > 180.0f) angle = 180.0f;

    uint32_t pulse_us = SERVO_MIN_US +
                        (uint32_t)(((angle / 180.0f) * (float)(SERVO_MAX_US - SERVO_MIN_US)));

    __HAL_TIM_SET_COMPARE(s->htim, s->channel, pulse_us);
}

/* Start a smooth move to target_angle over duration_ms */
void servo_move_to(Servo_t *s, float target_angle, uint32_t duration_ms)
{
    s->start_deg    = s->angle_deg;
    s->target_deg   = target_angle;
    s->start_tick   = HAL_GetTick();
    s->duration_ms  = duration_ms;
    s->moving       = 1;
}

/* Call repeatedly (e.g. every 10 ms in main loop or from a timer IRQ) */
void servo_update(Servo_t *s)
{
    if (!s->moving) return;

    uint32_t now = HAL_GetTick();
    uint32_t elapsed = now - s->start_tick;

    if (elapsed >= s->duration_ms) {
        s->angle_deg = s->target_deg;
        servo_set_angle(s, s->angle_deg);
        s->moving = 0;
        return;
    }

    float t = (float)elapsed / (float)s->duration_ms;   /* 0.0 -> 1.0 */
    float sc = smootherstep(t);                         /* cubic S-curve */

    s->angle_deg = s->start_deg + (s->target_deg - s->start_deg) * sc;
    servo_set_angle(s, s->angle_deg);
}

