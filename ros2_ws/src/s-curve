typedef struct {
    TIM_HandleTypeDef *htim;
    uint32_t          channel;
    float             angle;      /* current commanded angle */
    float             target;     /* target angle */
    float             start_angle;
    uint32_t          start_tick;
    uint32_t          duration_ms;
    uint8_t           moving;
} Servo_t;

Servo_t my_servo;

/* Smootherstep S-curve: 6t^5 - 15t^4 + 10t^3 */
static float smootherstep(float t)
{
    if (t <= 0.0f) return 0.0f;
    if (t >= 1.0f) return 1.0f;
    float t2 = t * t;
    float t3 = t2 * t;
    float t4 = t3 * t;
    float t5 = t4 * t;
    return (6.0f * t5) - (15.0f * t4) + (10.0f * t3);
}

/* Map angle 0-180 to PWM compare value for 50Hz (20ms period)
   Example: if timer is 1 MHz and prescaler/arr set for 20000 ticks = 20 ms
   0.5 ms = 500 ticks, 2.5 ms = 2500 ticks */
static void servo_set_angle(Servo_t *s, float angle)
{
    if (angle < 0.0f)  angle = 0.0f;
    if (angle > 180.0f) angle = 180.0f;

    /* Adjust PULSE_MIN/PULSE_MAX to your timer tick resolution */
    const uint32_t PULSE_MIN = 500;   /* 0.5 ms @ 1MHz */
    const uint32_t PULSE_MAX = 2500;  /* 2.5 ms @ 1MHz */

    uint32_t pulse = PULSE_MIN + (uint32_t)((angle / 180.0f) * (float)(PULSE_MAX - PULSE_MIN));
    __HAL_TIM_SET_COMPARE(s->htim, s->channel, pulse);
}

/* Start a smooth move */
void servo_move_to(Servo_t *s, float target_angle, uint32_t duration_ms)
{
    s->start_angle   = s->angle;       /* where we are now */
    s->target        = target_angle;
    s->start_tick    = HAL_GetTick();
    s->duration_ms   = duration_ms;
    s->moving        = 1;
}

/* Call this repeatedly from main loop (or a 10-50 ms timer interrupt) */
void servo_update(Servo_t *s)
{
    if (!s->moving) return;

    uint32_t now = HAL_GetTick();
    uint32_t elapsed = now - s->start_tick;

    if (elapsed >= s->duration_ms) {
        s->angle = s->target;
        servo_set_angle(s, s->angle);
        s->moving = 0;
        return;
    }

    float t = (float)elapsed / (float)s->duration_ms;   /* 0 -> 1 */
    float s_curve = smootherstep(t);                   /* 0 -> 1 S-shape */
    s->angle = s->start_angle + (s->target - s->start_angle) * s_curve;

    servo_set_angle(s, s->angle);
}

