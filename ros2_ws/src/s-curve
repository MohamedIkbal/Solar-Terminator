    TIM_HandleTypeDef *htim;
    uint32_t           channel;
    float              angle_deg;    /* current angle */
    float              target_deg;   /* target angle */
    float              start_deg;    /* angle where current move began */
    uint32_t           start_tick;   /* HAL_GetTick() when move started */
    uint32_t           duration_ms;  /* total move time in ms */
    uint8_t            moving;       /* 1 = move in progress */
